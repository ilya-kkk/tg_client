{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "issues",
    "task_done",
    "should_continue"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "needs_changes",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "type",
          "message",
          "fix_hint"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "bug",
              "requirement_gap",
              "test_gap",
              "other"
            ]
          },
          "message": {
            "type": "string"
          },
          "fix_hint": {
            "type": "string"
          }
        }
      }
    },
    "task_done": {
      "type": "boolean"
    },
    "should_continue": {
      "type": "boolean"
    }
  }
}
