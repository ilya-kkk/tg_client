# Telegram API credentials
# Получите на https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here
TELEGRAM_CLIENT_API_ID=your_api_id_here
TELEGRAM_CLIENT_API_HASH=your_api_hash_here

# Local SQLite database path
DATABASE_PATH=data/app.db

# Optional PostgreSQL for N8N/Adminer profile
POSTGRES_DB=tgcrm
POSTGRES_USER=tgcrm
POSTGRES_PASSWORD=change_me_secure_password

# Optional container ports
N8N_PORT=5678
ADMINER_PORT=8080
